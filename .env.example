# Session JWT from a logged-in Notion Calendar browser session (~5h TTL).
# Copy from DevTools → Network → Authorization on a calendar-api.notion.so request.
# Do not commit a filled-in copy of this file.
NOTION_CALENDAR_AUTHORIZATION=Bearer YOUR_SESSION_JWT
# or:
# NOTION_CALENDAR_TOKEN=YOUR_SESSION_JWT
# optional:
# NOTION_CALENDAR_BASE_URL=https://calendar-api.notion.so
